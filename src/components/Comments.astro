---
/**
 * giscus comments (GitHub Discussions). repo + repoId come from PUBLIC_GISCUS_*
 * env vars (set on the Cloudflare Pages project); category is fixed. Renders
 * nothing until they're present, so the site works before comments are wired up.
 *
 * Uses giscus's official <script src> embed — inline content scripts don't run
 * reliably under Astro's View Transitions, but external scripts do. Theme sync
 * therefore lives in public/toggle-theme.js (also external), which posts to the
 * giscus iframe whenever the site's data-theme changes.
 */
import { PUBLIC_GISCUS_REPO, PUBLIC_GISCUS_REPO_ID } from "astro:env/client"

const repo = PUBLIC_GISCUS_REPO
const repoId = PUBLIC_GISCUS_REPO_ID
const configured = Boolean(repo && repoId)
// giscus UI language follows the post's locale (server-rendered per language).
const lang = Astro.currentLocale === "zh" ? "zh-CN" : "en"
---

{
  configured && (
    <section class="mx-auto mt-8 w-full max-w-app px-4">
      <script
        is:inline
        data-astro-rerun
        src="https://giscus.app/client.js"
        data-repo={repo}
        data-repo-id={repoId}
        data-category="Announcements"
        data-category-id="DIC_kwDOCFm7w84DAiWm"
        data-mapping="pathname"
        data-strict="1"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang={lang}
        crossorigin="anonymous"
        async
      />
    </section>
  )
}
